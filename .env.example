# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Configuration
# Comma-separated list of emails that should be automatically granted admin rights
ADMIN_EMAILS=admin@example.com

# For production, update NEXT_PUBLIC_SITE_URL to your Vercel domain (e.g., https://ohmyreads.vercel.app)

# Primary (cheapest - ~$0.17 per 1000 queries)
GOOGLE_GENERATIVE_AI_API_KEY=

# OR fallback options
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# Mapbox Configuration
# Public token for client-side map rendering (Mapbox GL JS)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token
# Server-side token for MCP API calls (can be same as public token)
MAPBOX_ACCESS_TOKEN=your_mapbox_token

# Sentry Error Monitoring
# Without a DSN the SDK initializes as a no-op: the app runs fine but no server,
# edge, or client errors are reported. Set this in production.
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
# Org/project/auth token are build-time only — they enable source map upload so
# stack traces are readable. Safe to leave unset for local development.
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Rate Limiting (Vercel KV / Upstash Redis)
# ⚠ WITHOUT BOTH OF THESE, RATE LIMITING SILENTLY DEGRADES TO PER-INSTANCE
# MEMORY. On serverless that is not a rate limit at all — each function
# instance keeps its own counter, so the effective limit is multiplied by the
# number of instances. Set both in production.
# (When they ARE set and KV then fails, the limiter deliberately fails closed
# and returns 429 rather than falling back.)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cron Jobs
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`. The weekly-digest
# route fails closed with 503 when this is unset, so scheduled email never runs
# without it.
CRON_SECRET=

# Email unsubscribe links
# HMAC key for the signed one-click unsubscribe link in every digest
# (GET|POST /api/email/unsubscribe?u=<id>&t=<sig>). Optional: falls back to
# CRON_SECRET. Rotating it invalidates links in already-sent emails.
EMAIL_TOKEN_SECRET=

# Database Webhooks
# Shared secret for POST /api/webhooks/supabase. Unset is rejected in
# production and only allowed (with a warning) in development.
SUPABASE_WEBHOOK_SECRET=

# Seeding
# Required by POST /api/seed for destructive `force` operations. Leave unset
# outside development — without it the endpoint refuses to run them.
SEED_TOKEN=

# Email (Resend)
# Without an API key the client is never constructed and every send is skipped:
# the app keeps working, welcome and digest email simply does not go out.
RESEND_API_KEY=
# Defaults to "OhMyReads <hello@ohmyreads.com>" when unset.
RESEND_FROM_EMAIL=

# Google Places
# Server-side key for POST /api/geo/places/enrich. Place enrichment is skipped
# when unset; the rest of the map is unaffected.
GOOGLE_PLACES_API_KEY=

# Affiliate Links
# Amazon associates tag appended to book buy-links. Unset means the links are
# still rendered, just without a tag.
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=

# Logging
# Debug-level logs are dropped in production unless this is set to any value.
DEBUG_LOGS=
